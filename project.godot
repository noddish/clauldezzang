config_version=5

[application]
config/name="Embercrypt — 잿불 묘지"
config/version="0.6.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="A mobile-first, first-person pixel dungeon prototype."

[display]
window/size/viewport_width=1280
window/size/viewport_height=760
window/size/window_width_override=1280
window/size/window_height_override=760
window/size/min_width=360
window/size/min_height=360
window/stretch/mode="disabled"
window/stretch/aspect="expand"
window/handheld/orientation=6

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.025, 0.04, 0.045, 1)

[input_devices]
pointing/emulate_mouse_from_touch=false

[audio]
driver/enable_input=false
