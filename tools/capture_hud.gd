extends "res://tests/test_ui.gd"
## Reproducible visual review / interaction video. Run with --fresh.
var capture_dir := "res://previews"

func shot(name: String) -> void:
	await settle(0.45)
	var error := root.get_texture().get_image().save_png(capture_dir.path_join(name + ".png"))
	assert(error == OK)
	print("CAPTURE ", name)

func _run() -> void:
	root.size = Vector2i(844, 390)
	game = load("res://main.tscn").instantiate()
	root.add_child(game)
	h = game.hud
	h.hover_enabled = false
	await settle(0.7)
	await shot("explore-landscape")
	await tap("movement")
	await shot("movement-landscape")
	await tap("movement")
	await swipe(Vector2(420, 180), Vector2(0, -90))
	await tap("map")
	await shot("map-landscape")
	var center: Vector2 = h.map_rect.get_center()
	touch(center - Vector2(25, 0), true, 0)
	touch(center + Vector2(25, 0), true, 1)
	for i in range(12):
		drag(center - Vector2(25 + i * 3, 0), 0)
		drag(center + Vector2(25 + i * 3, 0), 1)
		await settle(0.03)
	touch(center - Vector2(58, 0), false, 0)
	touch(center + Vector2(58, 0), false, 1)
	await settle(0.5)
	await tap("close")
	await tap("menu")
	await tap("party")
	await shot("party-landscape")
	await swipe(h.body_rect.position + Vector2(180, 140), Vector2(-90, 0))
	await settle(0.5)
	await tap("party_done")
	await fresh(true)
	await shot("combat-landscape")
	await tap("tactics")
	await shot("tactics-landscape")
	await tap("guard", 1.1)
	await tap("hero_2")
	await tap("skill", 1.1)
	await tap("menu")
	await tap("bag")
	await shot("bag-landscape")
	await tap("item_potion")
	await tap("target_0")
	await shot("item-landscape")
	await tap("use_potion_0", 1.1)
	if "--hud-movie" in OS.get_cmdline_user_args():
		print("HUD MOVIE COMPLETE")
		quit()
		return
	await fresh(true)
	root.size = Vector2i(390, 844)
	await settle()
	await shot("combat-portrait")
	await tap("party")
	await shot("party-portrait")
	await tap("close")
	await tap("menu")
	await shot("menu-portrait")
	await tap("bag")
	await shot("bag-portrait")
	await tap("expand_sheet")
	await shot("bag-expanded")
	await tap("item_potion")
	game.state.hp[0] = 32; h.sync_state()
	await shot("item-portrait")
	await tap("close")
	await tap("map")
	h.map_zoom = 1.0
	h.map_pan = Vector2.ZERO
	await shot("map-portrait")
	await fresh()
	await shot("explore-portrait")
	print("HUD CAPTURE COMPLETE")
	quit()
